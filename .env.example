# =========================
# Backend required
# =========================
PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
SMARTSHEET_API_TOKEN=
SMARTSHEET_SHEET_ID=

# Comma-separated allowed origins for local UI/API access.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =========================
# Authentication (required)
# =========================
# Generate a strong random string for JWT signing (e.g. openssl rand -hex 32)
JWT_SECRET=

# Bcrypt password hashes for the 3 internal users.
# Run: npx tsx scripts/hash-password.ts <password>  to generate a hash.
AUTH_ANTHONY_PASSWORD_HASH=
AUTH_DEE_PASSWORD_HASH=
AUTH_JAMES_PASSWORD_HASH=

# Optional override for note/reply author user id.
INTERNAL_NOTE_AUTHOR_USER_ID=11111111-1111-4111-8111-111111111111

# =========================
# Email (optional)
# =========================
# If EMAIL_LOG_ONLY=true, replies are logged and stored but not sent.
EMAIL_LOG_ONLY=true
# In non-production, sending is blocked unless true.
EMAIL_ALLOW_SEND_IN_DEV=false
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
